%==========================================================
% kevinresume.sty - shared ATS-safe style for all variants
%
% Keep this file in the SAME FOLDER as the .tex files.
% On Overleaf: upload it alongside them, no extra config needed.
%
% ATS RULES BAKED IN (do not undo these):
%   1. Single column. No tabular / multicol anywhere.
%   2. \pagestyle{empty} - no header, no footer, no page number.
%      (A footer is what produced "Page 1GhostWorker" in the old CV.)
%   3. Links render as visible text, never as a bare word like "GitHub".
%   4. Plain ASCII hyphens in codes (AI-102, DP-800).
%   5. Standard section names only.
%   6. On any \hfill line, keep the LEFT text short enough that a real
%      gap survives, or the text extractor glues left to right.
%==========================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{kevinresume}[2026/09/30 ATS-safe resume style]

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{mathptmx}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{geometry}
\RequirePackage{microtype}
\hypersetup{pdfauthor={Kevin Kattakayam},pdftitle={Kevin Kattakayam - Resume},pdfsubject={Resume},pdfkeywords={Software Engineer, AI, Machine Learning, Backend, Full Stack}}
\RequirePackage{needspace}   % keeps a project/job heading together with its first bullets
\RequirePackage[strings]{underscore}  % lets repo slugs like pharma_trace be typed literally

\pagestyle{empty}
\raggedright
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

% ---------- Section styling ----------
\titleformat{\section}
  {\normalsize\bfseries\uppercase}
  {}{0em}{}
  [\vspace{-6pt}\rule{\textwidth}{0.6pt}]

% ---------- Personal details (single source of truth) ----------
